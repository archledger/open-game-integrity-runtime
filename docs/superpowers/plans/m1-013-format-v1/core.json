  "ast_meta_schema": {
    "closed": true,
    "node_required_members": ["opcode", "operands"],
    "node_optional_members": [],
    "unknown_members_forbidden": true,
    "unknown_opcodes_forbidden": true,
    "recursive_values": ["node", "literal"],
    "opcodes": {
      "literal": {
        "operands": ["value"],
        "arity": 1,
        "result": "json-value"
      },
      "read": {
        "operands": ["namespace", "json_pointer"],
        "arity": 2,
        "result": "json-value"
      },
      "object": {
        "operands": ["members"],
        "arity": 1,
        "operand_contract": "closed-object-of-id-to-node",
        "result": "json-object"
      },
      "array": {
        "operands": ["items"],
        "arity": 1,
        "operand_contract": "array-of-node",
        "result": "json-array"
      },
      "replace": {
        "operands": ["source", "json_pointer", "expected_old", "replacement"],
        "arity": 4,
        "precondition": "pointer-exists-once-and-value-matches-expected-old",
        "result": "same-json-kind-as-source"
      },
      "remove": {
        "operands": ["source", "json_pointer", "expected_old"],
        "arity": 3,
        "precondition": "pointer-exists-once-and-value-matches-expected-old",
        "result": "same-json-kind-as-source"
      },
      "insert": {
        "operands": ["source", "json_pointer", "value"],
        "arity": 3,
        "precondition": "target-does-not-exist-and-parent-exists-once",
        "result": "same-json-kind-as-source"
      },
      "append": {
        "operands": ["source", "json_pointer", "value"],
        "arity": 3,
        "precondition": "pointer-identifies-one-array",
        "result": "same-json-kind-as-source"
      },
      "bytes-replace": {
        "operands": ["source", "expected_occurrences", "old_ascii", "new_ascii"],
        "arity": 4,
        "precondition": "actual-occurrences-equal-expected-occurrences",
        "result": "bytes"
      },
      "concat": {
        "operands": ["values"],
        "arity": 1,
        "operand_contract": "nonempty-array-of-uniform-string-or-bytes-nodes",
        "result": "same-kind-as-values"
      },
      "repeat": {
        "operands": ["value", "count"],
        "arity": 2,
        "precondition": "count-is-nonnegative-integer-not-boolean",
        "result": "array"
      },
      "resource-boundary": {
        "operands": ["scope", "dimension", "relation"],
        "arity": 3,
        "operand_contract": "scope-and-dimension-exist-in-resource-limits-and-relation-is-exact-or-over",
        "result": "bounded-json-constructor"
      }
    }
  },
